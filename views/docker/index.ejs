<%- include('../partials/header', { title: 'Docker' }) %>

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight">Docker</h1>
    <p class="mt-1 text-sm text-slate-500">
      <span class="font-medium text-emerald-700"><%= counts.running %> running</span> of <%= counts.total %> containers<% if (counts.unhealthy) { %> · <span class="font-medium text-rose-600"><%= counts.unhealthy %> unhealthy</span><% } %>
    </p>
  </div>
  <a href="/docker" class="btn-secondary self-start sm:self-auto"><%- icon('rerun') %> Refresh</a>
</div>

<%- include('_tabs', { current: 'containers' }) %>
<%- include('_notice') %>

<% if (!groups.length) { %>
  <div class="card px-6 py-16 text-center text-sm text-slate-500">No containers on this host.</div>
<% } %>

<div class="space-y-6">
  <% groups.forEach(g => { %>
    <section class="card overflow-hidden">
      <div class="card-header">
        <div class="flex min-w-0 items-center gap-3">
          <span class="flex h-8 w-8 flex-none items-center justify-center rounded-lg <%= g.project ? 'bg-indigo-50 text-indigo-600' : 'bg-slate-100 text-slate-500' %>"><%- icon(g.project ? 'layers' : 'container') %></span>
          <div class="min-w-0">
            <h2 class="truncate text-sm font-semibold"><%= g.project || 'Standalone containers' %></h2>
            <p class="text-xs text-slate-500"><%= g.project ? 'Compose project · ' : '' %><%= g.containers.filter(c => c.state === 'running').length %>/<%= g.containers.length %> running</p>
          </div>
        </div>
        <% if (g.project) { %>
          <div class="flex flex-none items-center gap-1">
            <% [['start', 'Start all', 'play', ''], ['restart', 'Restart all', 'rerun', 'Restart every container in ' + g.project + '?'], ['stop', 'Stop all', 'stop', 'Stop every container in ' + g.project + '?']].forEach(([a, label, ic, conf]) => { %>
              <form method="post" action="/docker/projects/<%= encodeURIComponent(g.project) %>/<%= a %>" <% if (conf) { %>onsubmit="return confirm(<%= JSON.stringify(conf) %>);"<% } %>>
                <%- include('../partials/csrf') %>
                <button class="btn px-2.5 py-1.5 text-xs text-slate-600 hover:bg-slate-100" title="<%= label %>"><%- icon(ic, 'h-3.5 w-3.5') %><span class="hidden sm:inline"><%= label %></span></button>
              </form>
            <% }) %>
          </div>
        <% } %>
      </div>
      <ul class="divide-y divide-slate-100">
        <% g.containers.forEach(c => { %>
          <li class="flex flex-col gap-3 px-5 py-4 lg:flex-row lg:items-center">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <a href="/docker/containers/<%= encodeURIComponent(c.name) %>" class="truncate font-mono text-sm font-medium text-slate-900 hover:text-indigo-600"><%= c.name %></a>
                <%- containerBadge(c.state, c.health) %>
              </div>
              <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
                <span class="truncate font-mono" title="Image"><%= c.image %></span>
                <span><%= c.status %></span>
                <% c.ports.forEach(p => { %>
                  <a href="http://<%= host %>:<%= p.public %>" target="_blank" rel="noopener" class="inline-flex items-center gap-1 rounded bg-slate-100 px-1.5 py-0.5 font-mono text-slate-600 hover:bg-indigo-50 hover:text-indigo-700" title="Open port <%= p.public %>"><%= p.public %>:<%= p.private %><%- icon('external', 'h-3 w-3') %></a>
                <% }) %>
              </div>
            </div>
            <% if (c.state === 'running') { %>
              <div class="grid w-full grid-cols-2 gap-3 text-xs text-slate-500 lg:w-56" data-stats="<%= c.id %>">
                <div>
                  <div class="flex justify-between"><span>CPU</span><span data-cpu class="font-mono text-slate-700">…</span></div>
                  <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-slate-100"><div data-cpu-bar class="h-full w-0 rounded-full bg-indigo-500 transition-all"></div></div>
                </div>
                <div>
                  <div class="flex justify-between"><span>Mem</span><span data-mem class="font-mono text-slate-700">…</span></div>
                  <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-slate-100"><div data-mem-bar class="h-full w-0 rounded-full bg-sky-500 transition-all"></div></div>
                </div>
              </div>
            <% } else { %>
              <div class="hidden w-56 lg:block"></div>
            <% } %>
            <div class="flex flex-none items-center gap-1">
              <a href="/docker/containers/<%= encodeURIComponent(c.name) %>?tab=logs" class="btn px-2.5 py-1.5 text-xs text-indigo-700 hover:bg-indigo-50"><%- icon('terminal', 'h-3.5 w-3.5') %> Logs</a>
              <%- include('_actions', { c, compact: true, returnTo: 'list' }) %>
            </div>
          </li>
        <% }) %>
      </ul>
    </section>
  <% }) %>
</div>

<script>
  (function () {
    function fmtBytes(n) {
      if (!n) return '0 B';
      var u = ['B', 'KB', 'MB', 'GB', 'TB'], i = Math.min(4, Math.floor(Math.log(n) / Math.log(1024)));
      return (n / Math.pow(1024, i)).toFixed(i ? 1 : 0) + ' ' + u[i];
    }
    function load() {
      fetch('/docker/stats.json', { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (all) {
        document.querySelectorAll('[data-stats]').forEach(function (el) {
          var s = all[el.getAttribute('data-stats')];
          if (!s) return;
          el.querySelector('[data-cpu]').textContent = s.cpu.toFixed(1) + '%';
          el.querySelector('[data-cpu-bar]').style.width = Math.min(100, s.cpu) + '%';
          el.querySelector('[data-mem]').textContent = fmtBytes(s.memUsed);
          el.querySelector('[data-mem-bar]').style.width = Math.min(100, s.memPercent) + '%';
          el.title = 'Memory: ' + fmtBytes(s.memUsed) + ' of ' + fmtBytes(s.memLimit) + ' (' + s.memPercent + '%)';
        });
      }).catch(function () {});
    }
    load();
    setInterval(load, 10000);
  })();
</script>

<%- include('../partials/footer') %>
