<div class="mb-6 flex gap-1 border-b border-slate-200">
  <% [['containers', '/docker', 'Containers', 'container'], ['images', '/docker/images', 'Images', 'layers']].forEach(([key, href, label, ic]) => { %>
    <a href="<%= href %>" class="-mb-px flex items-center gap-2 border-b-2 px-4 py-2.5 text-sm font-medium <%= current === key ? 'border-indigo-600 text-indigo-700' : 'border-transparent text-slate-500 hover:text-slate-800' %>"><%- icon(ic) %> <%= label %></a>
  <% }) %>
</div>
