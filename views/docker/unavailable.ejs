<%- include('../partials/header', { title: 'Docker' }) %>

<div class="mb-8">
  <h1 class="text-2xl font-semibold tracking-tight">Docker</h1>
</div>

<div class="card px-6 py-14 text-center">
  <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-rose-50 text-rose-600"><%- icon('alert', 'h-6 w-6') %></div>
  <h2 class="mt-4 text-base font-semibold">Docker is unavailable</h2>
  <p class="mx-auto mt-1 max-w-lg text-sm text-slate-600"><%= message %></p>
  <p class="mt-3 text-xs text-slate-400">Socket: <code class="font-mono"><%= socket %></code> (set <code class="font-mono">DOCKER_SOCKET</code> in .env to change it)</p>
  <a href="" class="btn-secondary mt-6"><%- icon('rerun') %> Try again</a>
</div>

<%- include('../partials/footer') %>
