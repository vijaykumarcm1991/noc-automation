<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign in — Automation Tool</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-900 min-h-screen flex items-center justify-center">
  <div class="bg-white p-8 rounded-lg shadow w-full max-w-md">
    <div class="text-center mb-6">
      <img src="/logo.png" alt="Automation Tool logo" class="h-16 w-auto mx-auto">
      <p class="text-gray-500 text-sm mt-4">Sign in as admin</p>
    </div>

    <% if (error) { %>
      <div class="bg-red-100 text-red-700 border border-red-300 rounded px-3 py-2 mb-4 text-sm"><%= error %></div>
    <% } %>

    <form method="post" action="/login" class="space-y-4">
      <div>
        <label class="block font-medium mb-1" for="username">Username</label>
        <input id="username" name="username" required autocomplete="username" class="w-full border rounded px-3 py-2">
      </div>
      <div>
        <label class="block font-medium mb-1" for="password">Password</label>
        <input id="password" name="password" type="password" required autocomplete="current-password" class="w-full border rounded px-3 py-2">
      </div>
      <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700">Sign in</button>
    </form>
  </div>
</body>
</html>
