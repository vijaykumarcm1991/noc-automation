<%- include('../partials/header', { title: 'Run History' }) %>

<h1 class="text-2xl font-bold mb-6">Run History</h1>

<% if (runs.length === 0) { %>
  <p class="text-gray-500">No runs yet. Trigger a job to see its output here.</p>
<% } else { %>
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-gray-500">
        <tr>
          <th class="px-4 py-2">#</th>
          <th class="px-4 py-2">Job</th>
          <th class="px-4 py-2">Status</th>
          <th class="px-4 py-2">Started</th>
          <th class="px-4 py-2">Exit</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody>
        <% runs.forEach(r => { %>
          <tr class="border-t">
            <td class="px-4 py-2 text-gray-500"><%= r.id %></td>
            <td class="px-4 py-2 font-medium"><%= r.job_name %></td>
            <td class="px-4 py-2">
              <% const cls = r.status === 'success' ? 'text-green-600' : (r.status === 'running' ? 'text-blue-600' : 'text-red-600'); %>
              <span class="<%= cls %> font-medium"><%= r.status %></span>
            </td>
            <td class="px-4 py-2 text-gray-500"><%= r.started_at %></td>
            <td class="px-4 py-2 font-mono text-xs"><%= r.exit_code ?? '—' %></td>
            <td class="px-4 py-2"><a href="/runs/<%= r.id %>" class="text-blue-600 hover:underline">View</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
