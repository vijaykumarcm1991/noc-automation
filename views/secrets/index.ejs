<%- include('../partials/header', { title: 'Secrets Vault' }) %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Secrets Vault</h1>
  <a href="/secrets/new" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">+ New Secret</a>
</div>

<% if (secrets.length === 0) { %>
  <p class="text-gray-500">Vault is empty. <a href="/secrets/new" class="text-blue-600 underline">Add a secret</a>.</p>
<% } else { %>
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-gray-500">
        <tr>
          <th class="px-4 py-2">Name</th>
          <th class="px-4 py-2">Created</th>
          <th class="px-4 py-2">Updated</th>
          <th class="px-4 py-2">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% secrets.forEach(s => { %>
          <tr class="border-t">
            <td class="px-4 py-2 font-medium"><%= s.name %></td>
            <td class="px-4 py-2 text-gray-500"><%= s.created_at %></td>
            <td class="px-4 py-2 text-gray-500"><%= s.updated_at %></td>
            <td class="px-4 py-2">
              <a href="/secrets/<%= s.id %>/edit" class="text-blue-600 hover:underline mr-3">Edit</a>
              <form method="post" action="/secrets/<%= s.id %>/delete" onsubmit="return confirm('Delete this secret?');" class="inline">
                <button class="text-red-600 hover:underline">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="text-xs text-gray-500 mt-2">Secret values are encrypted at rest and never shown here. They are only decrypted in memory when a linked job runs.</p>
<% } %>

<%- include('../partials/footer') %>
