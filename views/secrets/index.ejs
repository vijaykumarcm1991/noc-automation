<%- include('../partials/header', { title: 'Secrets vault' }) %>

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight">Secrets vault</h1>
    <p class="mt-1 text-sm text-slate-500">Encrypted at rest with AES-256-GCM. Values are never shown, only decrypted in memory when a linked job runs.</p>
  </div>
  <a href="/secrets/new" class="btn-primary self-start sm:self-auto"><%- icon('plus') %> New secret</a>
</div>

<% if (secrets.length === 0) { %>
  <div class="card px-6 py-16 text-center">
    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-indigo-50 text-indigo-600"><%- icon('lock', 'h-6 w-6') %></div>
    <h2 class="mt-4 text-base font-semibold">The vault is empty</h2>
    <p class="mt-1 text-sm text-slate-500">Add API tokens, passwords and other credentials your jobs need.</p>
    <a href="/secrets/new" class="btn-primary mt-6"><%- icon('plus') %> New secret</a>
  </div>
<% } else { %>
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50/80">
          <tr>
            <th class="th">Name</th>
            <th class="th hidden md:table-cell">Value</th>
            <th class="th">Used by</th>
            <th class="th hidden sm:table-cell">Updated (<%= tz %>)</th>
            <th class="th text-right"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% secrets.forEach(s => { %>
            <tr class="transition hover:bg-slate-50/60">
              <td class="td">
                <div class="flex items-center gap-3">
                  <span class="flex h-8 w-8 flex-none items-center justify-center rounded-lg bg-slate-100 text-slate-500"><%- icon('key', 'h-4 w-4') %></span>
                  <span class="font-mono text-sm font-medium text-slate-900"><%= s.name %></span>
                </div>
              </td>
              <td class="td hidden md:table-cell"><span class="font-mono text-xs tracking-widest text-slate-400">••••••••••</span></td>
              <td class="td">
                <% if (s.job_count) { %>
                  <span class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700"><%= s.job_count %> job<%= s.job_count === 1 ? '' : 's' %></span>
                <% } else { %>
                  <span class="text-xs text-slate-400">Unused</span>
                <% } %>
              </td>
              <td class="td hidden whitespace-nowrap sm:table-cell">
                <div class="text-slate-700"><%= fmtTime(s.updated_at) %></div>
                <div class="text-xs text-slate-400"><%= fromNow(s.updated_at) %></div>
              </td>
              <td class="td">
                <div class="flex items-center justify-end gap-1">
                  <a href="/secrets/<%= s.id %>/edit" class="icon-btn" title="Change value" aria-label="Change value"><%- icon('pencil') %></a>
                  <form method="post" action="/secrets/<%= s.id %>/delete" onsubmit="return confirm(<%= JSON.stringify(s.job_count ? 'This secret is used by ' + s.job_count + ' job(s); they will stop receiving it. Delete anyway?' : 'Delete this secret?') %>);">
                    <%- include('../partials/csrf') %>
                    <button class="icon-btn hover:bg-rose-50 hover:text-rose-600" title="Delete" aria-label="Delete"><%- icon('trash') %></button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
