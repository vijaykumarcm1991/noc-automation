<%- include('../partials/header', { title: 'Edit secret' }) %>

<div class="mb-8">
  <a href="/secrets" class="mb-3 inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-slate-900"><%- icon('back') %> Secrets vault</a>
  <h1 class="text-2xl font-semibold tracking-tight">Change secret value</h1>
  <p class="mt-1 text-sm text-slate-500">The current value of <code class="font-mono font-medium text-slate-700"><%= secret.name %></code> is hidden. Enter a new value to replace it.</p>
</div>

<%- include('../partials/errors', { errors: error ? [error] : [] }) %>

<form method="post" action="/secrets/<%= secret.id %>/edit" class="card max-w-2xl">
  <%- include('../partials/csrf') %>
  <div class="space-y-5 p-6">
    <div>
      <label class="label" for="name">Name</label>
      <input id="name" value="<%= secret.name %>" disabled class="input cursor-not-allowed bg-slate-50 font-mono text-slate-500">
      <p class="hint">Names can't be changed. Last updated <%= fmtTime(secret.updated_at) %> <%= tz %>.</p>
    </div>
    <div>
      <label class="label" for="value">New value</label>
      <textarea id="value" name="value" required rows="4" placeholder="Paste the new secret value" autocomplete="off" spellcheck="false" class="input font-mono"></textarea>
      <p class="hint flex items-center gap-1.5"><%- icon('lock', 'h-3.5 w-3.5') %> Re-encrypted with AES-256-GCM before it is stored.</p>
    </div>
  </div>
  <div class="flex items-center justify-end gap-2 rounded-b-xl border-t border-slate-100 bg-slate-50/70 px-6 py-4">
    <a href="/secrets" class="btn-secondary">Cancel</a>
    <button type="submit" class="btn-primary">Save secret</button>
  </div>
</form>

<%- include('../partials/footer') %>
