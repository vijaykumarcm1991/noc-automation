<%- include('../partials/header', { title: 'Edit Secret' }) %>

<h1 class="text-2xl font-bold mb-2">Edit Secret</h1>
<p class="text-gray-600 mb-6">Changing the value of <strong><%= secret.name %></strong>. The current value is not shown for security; enter the new value below.</p>

<form method="post" action="/secrets/<%= secret.id %>/edit" class="bg-white p-6 rounded-lg shadow space-y-4 max-w-xl">
  <div>
    <label class="block font-medium mb-1" for="name">Name</label>
    <input id="name" value="<%= secret.name %>" disabled class="w-full border rounded px-3 py-2 bg-gray-100 text-gray-500">
  </div>

  <div>
    <label class="block font-medium mb-1" for="value">New value</label>
    <textarea id="value" name="value" required rows="3" placeholder="new-secret-value" class="w-full border rounded px-3 py-2 font-mono"></textarea>
    <p class="text-xs text-gray-500 mt-1">Re-encrypted with AES-256-GCM before it is stored.</p>
  </div>

  <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Save Secret</button>
  <a href="/secrets" class="text-gray-500 ml-2">Cancel</a>
</form>

<%- include('../partials/footer') %>
