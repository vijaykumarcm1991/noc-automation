<%- include('../partials/header', { title: 'New secret' }) %>

<div class="mb-8">
  <a href="/secrets" class="mb-3 inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-slate-900"><%- icon('back') %> Secrets vault</a>
  <h1 class="text-2xl font-semibold tracking-tight">New secret</h1>
</div>

<%- include('../partials/errors', { errors: error ? [error] : [] }) %>

<form method="post" action="/secrets" class="card max-w-2xl">
  <%- include('../partials/csrf') %>
  <div class="space-y-5 p-6">
    <div>
      <label class="label" for="name">Name</label>
      <input id="name" name="name" required value="<%= name %>" placeholder="API_KEY" pattern="[A-Za-z_][A-Za-z0-9_]*" autocomplete="off" class="input font-mono">
      <p class="hint">Becomes the environment variable name. Letters, digits and underscores; can't start with a digit.</p>
    </div>
    <div>
      <label class="label" for="value">Value</label>
      <textarea id="value" name="value" required rows="4" placeholder="Paste the secret value" autocomplete="off" spellcheck="false" class="input font-mono"></textarea>
      <p class="hint flex items-center gap-1.5"><%- icon('lock', 'h-3.5 w-3.5') %> Encrypted before it is stored. It will never be displayed again.</p>
    </div>
  </div>
  <div class="flex items-center justify-end gap-2 rounded-b-xl border-t border-slate-100 bg-slate-50/70 px-6 py-4">
    <a href="/secrets" class="btn-secondary">Cancel</a>
    <button type="submit" class="btn-primary">Save secret</button>
  </div>
</form>

<%- include('../partials/footer') %>
