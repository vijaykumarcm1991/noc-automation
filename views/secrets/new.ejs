<%- include('../partials/header', { title: 'New Secret' }) %>

<h1 class="text-2xl font-bold mb-6">New Secret</h1>

<form method="post" action="/secrets" class="bg-white p-6 rounded-lg shadow space-y-4 max-w-xl">
  <div>
    <label class="block font-medium mb-1" for="name">Name</label>
    <input id="name" name="name" required placeholder="API_KEY" class="w-full border rounded px-3 py-2 font-mono">
    <p class="text-xs text-gray-500 mt-1">Used as the environment variable name in jobs that use this secret.</p>
  </div>

  <div>
    <label class="block font-medium mb-1" for="value">Value</label>
    <textarea id="value" name="value" required rows="3" placeholder="secret-value-here" class="w-full border rounded px-3 py-2 font-mono"></textarea>
    <p class="text-xs text-gray-500 mt-1">Encrypted with AES-256-GCM before it is stored. Never displayed again.</p>
  </div>

  <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Save Secret</button>
  <a href="/secrets" class="text-gray-500 ml-2">Cancel</a>
</form>

<%- include('../partials/footer') %>
