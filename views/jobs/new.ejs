<%- include('../partials/header', { title: 'New Job' }) %>

<h1 class="text-2xl font-bold mb-6">New Job</h1>

<form method="post" action="/jobs" class="bg-white p-6 rounded-lg shadow space-y-4 max-w-2xl">
  <div>
    <label class="block font-medium mb-1" for="name">Name</label>
    <input id="name" name="name" required class="w-full border rounded px-3 py-2">
  </div>

  <div>
    <label class="block font-medium mb-1" for="command">Command</label>
    <input id="command" name="command" required placeholder="python3 script.py" class="w-full border rounded px-3 py-2 font-mono">
    <p class="text-xs text-gray-500 mt-1">Run through a shell. Linked secrets are injected as env vars.</p>
  </div>

  <div>
    <label class="block font-medium mb-1" for="working_dir">Working directory</label>
    <input id="working_dir" name="working_dir" placeholder="./scripts" class="w-full border rounded px-3 py-2">
  </div>

  <div>
    <label class="block font-medium mb-1" for="cron_schedule">Cron schedule</label>
    <input id="cron_schedule" name="cron_schedule" placeholder="0 2 * * *" class="w-full border rounded px-3 py-2 font-mono">
    <p class="text-xs text-gray-500 mt-1">5-field cron syntax (min hour dom mon dow). Leave blank for manual only.</p>
  </div>

  <div class="flex items-center gap-4">
    <div class="flex-1">
      <label class="block font-medium mb-1" for="timeout_sec">Timeout (seconds)</label>
      <input id="timeout_sec" name="timeout_sec" type="number" value="300" class="w-full border rounded px-3 py-2">
    </div>
    <div class="flex items-center gap-2 pt-6">
      <input id="enabled" name="enabled" type="checkbox" value="1" checked class="h-4 w-4">
      <label for="enabled" class="font-medium">Enable scheduling</label>
    </div>
  </div>

  <div>
    <label class="block font-medium mb-1">Secrets available to this job</label>
    <% if (secrets.length === 0) { %>
      <p class="text-xs text-gray-500">No secrets yet. <a href="/secrets/new" class="text-blue-600 underline">Add one</a>.</p>
    <% } else { %>
      <div class="grid grid-cols-2 gap-2">
        <% secrets.forEach(s => { %>
          <label class="flex items-center gap-2 border rounded px-3 py-2">
            <input type="checkbox" name="secret_ids" value="<%= s.id %>" class="h-4 w-4">
            <span><%= s.name %></span>
          </label>
        <% }) %>
      </div>
    <% } %>
  </div>

  <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Create Job</button>
  <a href="/jobs" class="text-gray-500 ml-2">Cancel</a>
</form>

<%- include('../partials/footer') %>
