<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<% if (typeof refresh !== 'undefined' && refresh) { %><meta http-equiv="refresh" content="<%= refresh %>"><% } %>
<title><%= typeof title !== 'undefined' ? title + ' · NOC Automation' : 'NOC Automation' %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com/3.4.17"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: {
          sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
          mono: ['"JetBrains Mono"', 'ui-monospace', 'SFMono-Regular', 'monospace'],
        },
      },
    },
  };
</script>
<style type="text/tailwindcss">
  @layer components {
    .card { @apply rounded-xl border border-slate-200 bg-white shadow-sm; }
    .card-header { @apply flex items-center justify-between gap-4 border-b border-slate-100 px-5 py-4; }
    .card-title { @apply text-sm font-semibold text-slate-900; }
    .btn { @apply inline-flex items-center justify-center gap-2 rounded-lg px-3.5 py-2 text-sm font-medium transition focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:opacity-50; }
    .btn-primary { @apply btn bg-indigo-600 text-white shadow-sm hover:bg-indigo-500 focus-visible:ring-indigo-500; }
    .btn-secondary { @apply btn border border-slate-300 bg-white text-slate-700 shadow-sm hover:bg-slate-50 focus-visible:ring-indigo-500; }
    .btn-danger { @apply btn bg-rose-600 text-white shadow-sm hover:bg-rose-500 focus-visible:ring-rose-500; }
    .btn-warn { @apply btn bg-amber-500 text-white shadow-sm hover:bg-amber-400 focus-visible:ring-amber-500; }
    .icon-btn { @apply inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 hover:text-slate-900; }
    .label { @apply mb-1.5 block text-sm font-medium text-slate-700; }
    .hint { @apply mt-1.5 text-xs text-slate-500; }
    .input { @apply block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20; }
    .th { @apply px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500; }
    .td { @apply px-5 py-3.5 align-middle; }
    .link { @apply font-medium text-indigo-600 hover:text-indigo-500; }
    .nav-link { @apply flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-slate-400 transition hover:bg-white/5 hover:text-white; }
    .nav-link-active { @apply bg-white/10 text-white; }
  }
</style>
