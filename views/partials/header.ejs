<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Automation Tool' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-900 min-h-screen">
  <nav class="bg-white border-b border-gray-200">
    <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
      <a href="/" class="flex items-center">
        <img src="/logo.png" alt="Automation Tool logo" class="h-10 w-auto">
      </a>
      <div class="flex items-center gap-6 ml-6">
        <a href="/jobs" class="text-gray-700 hover:text-slate-900">Jobs</a>
        <a href="/secrets" class="text-gray-700 hover:text-slate-900">Secrets Vault</a>
        <a href="/runs" class="text-gray-700 hover:text-slate-900">Run History</a>
      </div>
      <% if (typeof authed !== 'undefined' && authed) { %>
        <form method="post" action="/logout">
          <button class="text-gray-500 hover:text-slate-900 text-sm">Sign out</button>
        </form>
      <% } %>
    </div>
  </nav>
  <main class="max-w-5xl mx-auto px-4 py-6">
