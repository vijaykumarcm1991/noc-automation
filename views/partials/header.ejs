<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <%- include('head') %>
</head>
<body class="h-full bg-slate-50 font-sans text-slate-900 antialiased">
<%
  const navItems = [
    { key: 'dashboard', href: '/', label: 'Dashboard', icon: 'dashboard' },
    { key: 'scripts', href: '/scripts', label: 'Scripts', icon: 'code' },
    { key: 'jobs', href: '/jobs', label: 'Jobs', icon: 'zap' },
    { key: 'runs', href: '/runs', label: 'Run History', icon: 'history' },
    { key: 'secrets', href: '/secrets', label: 'Secrets Vault', icon: 'key' },
    { key: 'packages', href: '/packages', label: 'Python Packages', icon: 'package' },
  ];
%>
  <!-- Mobile top bar -->
  <div class="sticky top-0 z-30 flex h-14 items-center justify-between bg-slate-950 px-4 lg:hidden">
    <a href="/"><img src="/logo.png" alt="Logo" class="h-5 w-auto brightness-0 invert"></a>
    <button type="button" data-nav-toggle class="rounded-lg p-2 text-slate-300 hover:bg-white/10 hover:text-white" aria-label="Open menu">
      <%- icon('menu', 'h-5 w-5') %>
    </button>
  </div>

  <!-- Mobile backdrop -->
  <div data-nav-backdrop class="fixed inset-0 z-40 hidden bg-slate-950/60 backdrop-blur-sm lg:hidden"></div>

  <!-- Sidebar -->
  <aside data-nav class="fixed inset-y-0 left-0 z-50 hidden w-64 flex-col bg-slate-950 lg:flex">
    <div class="flex h-16 items-center justify-between px-6">
      <a href="/" class="flex flex-col">
        <img src="/logo.png" alt="Logo" class="h-5 w-auto self-start brightness-0 invert">
        <span class="mt-1.5 text-[11px] font-medium uppercase tracking-[0.18em] text-indigo-300/80">NOC Automation</span>
      </a>
      <button type="button" data-nav-toggle class="rounded-lg p-1.5 text-slate-400 hover:bg-white/10 hover:text-white lg:hidden" aria-label="Close menu">
        <%- icon('x', 'h-5 w-5') %>
      </button>
    </div>

    <nav class="mt-4 flex-1 space-y-1 px-3">
      <% navItems.forEach(item => { %>
        <a href="<%= item.href %>" class="nav-link <%= active === item.key ? 'nav-link-active' : '' %>">
          <%- icon(item.icon, 'h-[18px] w-[18px]') %>
          <%= item.label %>
          <% if (active === item.key) { %><span class="ml-auto h-1.5 w-1.5 rounded-full bg-indigo-400"></span><% } %>
        </a>
      <% }) %>
    </nav>

    <div class="mx-3 mb-3 rounded-xl bg-white/5 p-3">
      <div class="flex items-center gap-2 text-xs text-slate-400">
        <%- icon('clock', 'h-3.5 w-3.5') %> <span><%= tz %> · <%= appTz %></span>
      </div>
      <div data-clock data-tz="<%= appTz %>" class="mt-1 font-mono text-lg font-medium tabular-nums text-white">--:--:--</div>
      <div data-clock-date data-tz="<%= appTz %>" class="text-xs text-slate-400"></div>
    </div>

    <% if (typeof authed !== 'undefined' && authed) { %>
      <div class="flex items-center gap-3 border-t border-white/10 px-4 py-4">
        <div class="flex h-8 w-8 items-center justify-center rounded-full bg-indigo-500/20 text-indigo-300">
          <%- icon('user', 'h-4 w-4') %>
        </div>
        <div class="min-w-0 flex-1">
          <div class="truncate text-sm font-medium text-white"><%= adminUser %></div>
          <div class="text-xs text-slate-400">Administrator</div>
        </div>
        <form method="post" action="/logout">
          <%- include('csrf') %>
          <button class="rounded-lg p-2 text-slate-400 hover:bg-white/10 hover:text-white" title="Sign out" aria-label="Sign out">
            <%- icon('logout', 'h-4 w-4') %>
          </button>
        </form>
      </div>
    <% } %>
  </aside>

  <div class="lg:pl-64">
    <main class="mx-auto <%= typeof wide !== 'undefined' && wide ? 'max-w-[1600px]' : 'max-w-6xl' %> px-4 py-8 sm:px-6 lg:px-10">
