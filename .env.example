# Copy to .env and set a strong random master key (at least 32 bytes).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=replace_me_with_a_64_char_hex_key

# Single admin login. ADMIN_PASSWORD is required for authentication to be enabled.
# Change both from the defaults below.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# (Optional) separate secret for signing session cookies. Falls back to MASTER_KEY.
# SESSION_SECRET=

APP_PORT=3000
# APP_HOST=127.0.0.1   # listen on localhost only
DB_PATH=./data/automation.db

# Time zone for cron schedules, UI times and job TZ. Defaults to IST.
APP_TZ=Asia/Kolkata

# (Optional) script library folder and managed Python virtualenv.
# SCRIPTS_DIR=./scripts
# VENV_DIR=./data/venv
# PYTHON_BIN=python3

# (Optional) delete run history older than this many days. 0 keeps everything.
# RUN_RETENTION_DAYS=90

# (Optional) set to true when serving over HTTPS.
# COOKIE_SECURE=true

# (Optional) set when running behind a reverse proxy (e.g. 1) so the login rate
# limiter sees real client IPs.
# TRUST_PROXY=1
