{
  "name": "noc-automation",
  "version": "1.0.0",
  "description": "Automation tool with a scheduled job runner and an encrypted secrets vault for Node.js",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "build:editor": "esbuild editor/index.js --bundle --minify --format=iife --target=es2020 --outfile=public/vendor/editor.js"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "node-cron": "^4.6.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2"
  }
}
